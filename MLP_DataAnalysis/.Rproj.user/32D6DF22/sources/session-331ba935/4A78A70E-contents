## MLP

```{r mlp}
## MLP

lrelu       <- function(x) ifelse(x > 0, x, 0.01 * x)
lrelu_deriv <- function(x) ifelse(x > 0, 1.0, 0.01)
sigmoid     <- function(x) 1.0 / (1.0 + exp(-pmax(-500, pmin(500, x))))

bce_loss <- function(y_hat, y) {
  -mean(y * log(y_hat + 1e-8) + (1 - y) * log(1 - y_hat + 1e-8))
}

adam_update <- function(param, grad, m, v, t, lr = 0.001,
                        beta1 = 0.9, beta2 = 0.999, eps = 1e-8) {
  m     <- beta1 * m + (1 - beta1) * grad
  v     <- beta2 * v + (1 - beta2) * grad^2
  m_hat <- m / (1 - beta1^t)
  v_hat <- v / (1 - beta2^t)
  param <- param - lr * m_hat / (sqrt(v_hat) + eps)
  list(param = param, m = m, v = v)
}

# =============================================================================
# Balance training set
# =============================================================================

set.seed(42)
pos_idx_train   <- which(y_train == 1)
neg_idx_train   <- which(y_train == 0)
neg_idx_sampled <- sample(neg_idx_train, size = length(pos_idx_train))
balanced_idx    <- sample(c(pos_idx_train, neg_idx_sampled))
X_train_bal     <- X_train[balanced_idx, ]
y_train_bal     <- y_train[balanced_idx]

cat("Balanced train set:", nrow(X_train_bal), "rows | Positive rate:",
    round(mean(y_train_bal) * 100, 2), "%\n")

# =============================================================================
# Initialise weights and Adam moments
# =============================================================================

n_input  <- ncol(X_train_bal)
n_h1     <- 64
n_h2     <- 32
n_output <- 1

set.seed(42)
W1 <- matrix(rnorm(n_h1 * n_input),  nrow = n_h1)
W2 <- matrix(rnorm(n_h2 * n_h1),     nrow = n_h2)
W3 <- matrix(rnorm(n_output * n_h2), nrow = n_output)
b1 <- matrix(0, nrow = n_h1,     ncol = 1)
b2 <- matrix(0, nrow = n_h2,     ncol = 1)
b3 <- matrix(0, nrow = n_output, ncol = 1)

make_moments <- function(param) list(m = param * 0, v = param * 0)
adam <- list(
  W1 = make_moments(W1), W2 = make_moments(W2), W3 = make_moments(W3),
  b1 = make_moments(b1), b2 = make_moments(b2), b3 = make_moments(b3)
)

# =============================================================================
# Training loop
# =============================================================================

lr         <- 0.01
epochs     <- 400
batch_size <- 256
n          <- nrow(X_train_bal)
errors     <- numeric()
adam_t     <- 0

for (epoch in 1:epochs) {

  shuffle_idx <- sample(1:n)
  X_shuf      <- X_train_bal[shuffle_idx, ]
  y_shuf      <- y_train_bal[shuffle_idx]

  for (i in seq(1, n, by = batch_size)) {
    end <- min(i + batch_size - 1, n)
    if (end - i < 1) next
    X_batch <- t(X_shuf[i:end, ])
    y_batch <- y_shuf[i:end]
    m       <- ncol(X_batch)
    adam_t  <- adam_t + 1

    # Forward
    z1_pre <- W1 %*% X_batch + matrix(b1, nrow = n_h1, ncol = m)
    a1     <- lrelu(z1_pre)

    z2_pre <- W2 %*% a1 + matrix(b2, nrow = n_h2, ncol = m)
    a2     <- lrelu(z2_pre)

    z3    <- W3 %*% a2 + matrix(b3, nrow = n_output, ncol = m)
    y_hat <- sigmoid(z3)

    # Backward
    dz3  <- y_hat - matrix(y_batch, nrow = 1)
    dW3  <- (1/m) * dz3 %*% t(a2)
    db3  <- matrix((1/m) * rowSums(dz3))

    da2     <- t(W3) %*% dz3
    dz2_pre <- da2 * lrelu_deriv(z2_pre)
    dW2     <- (1/m) * dz2_pre %*% t(a1)
    db2_grad <- matrix((1/m) * rowSums(dz2_pre))

    da1     <- t(W2) %*% dz2_pre
    dz1_pre <- da1 * lrelu_deriv(z1_pre)
    dW1     <- (1/m) * dz1_pre %*% t(X_batch)
    db1_grad <- matrix((1/m) * rowSums(dz1_pre))

    # Adam updates
    upd <- function(key, param, grad) {
      r <- adam_update(param, grad, adam[[key]]$m, adam[[key]]$v, adam_t, lr)
      adam[[key]]$m <<- r$m; adam[[key]]$v <<- r$v
      r$param
    }
    W1 <- upd("W1", W1, dW1)
    b1 <- upd("b1", b1, db1_grad)
    W2 <- upd("W2", W2, dW2)
    b2 <- upd("b2", b2, db2_grad)
    W3 <- upd("W3", W3, dW3)
    b3 <- upd("b3", b3, db3)
  }

  # Epoch-end loss
  chunk <- 2000
  preds <- numeric(n)
  for (k in seq(1, n, by = chunk)) {
    ke  <- min(k + chunk - 1, n)
    xk  <- t(X_train_bal[k:ke, ])
    mk  <- ncol(xk)
    z1k <- W1 %*% xk + matrix(b1, nrow = n_h1, ncol = mk)
    a1k <- lrelu(z1k)
    z2k <- W2 %*% a1k + matrix(b2, nrow = n_h2, ncol = mk)
    a2k <- lrelu(z2k)
    z3k <- W3 %*% a2k + matrix(b3, nrow = n_output, ncol = mk)
    preds[k:ke] <- as.vector(sigmoid(z3k))
  }
  e <- bce_loss(preds, y_train_bal)
  errors <- c(errors, e)

  if (epoch %% 10 == 0) cat(sprintf("Epoch %d | Loss: %.4f\n", epoch, e))
}

plot(1:epochs, errors, type = "l",
     main = "Training Loss over Epochs",
     xlab = "Epoch", ylab = "BCE Loss",
     col = "steelblue", lwd = 2)

# =============================================================================
# Evaluation
# =============================================================================

chunk  <- 2000
y_prob <- numeric(nrow(X_test))
for (k in seq(1, nrow(X_test), by = chunk)) {
  ke  <- min(k + chunk - 1, nrow(X_test))
  xk  <- t(X_test[k:ke, ])
  mk  <- ncol(xk)
  z1k <- W1 %*% xk + matrix(b1, nrow = n_h1, ncol = mk)
  a1k <- lrelu(z1k)
  z2k <- W2 %*% a1k + matrix(b2, nrow = n_h2, ncol = mk)
  a2k <- lrelu(z2k)
  z3k <- W3 %*% a2k + matrix(b3, nrow = n_output, ncol = mk)
  y_prob[k:ke] <- as.vector(sigmoid(z3k))
}

y_pred <- as.integer(y_prob >= 0.5)

conf_matrix <- matrix(0, nrow = 2, ncol = 2,
                      dimnames = list(Predicted = c("0","1"),
                                      Actual    = c("0","1")))
for (p in c("0","1")) for (a in c("0","1")) {
  conf_matrix[p, a] <- sum(y_pred == as.integer(p) & y_test == as.integer(a))
}
print(conf_matrix)

accuracy  <- mean(y_pred == y_test)
tp        <- conf_matrix["1","1"]
fp        <- conf_matrix["1","0"]
fn        <- conf_matrix["0","1"]
precision <- if ((tp+fp)>0) tp/(tp+fp) else 0
recall    <- if ((tp+fn)>0) tp/(tp+fn) else 0
f1        <- if ((precision+recall)>0) 2*precision*recall/(precision+recall) else 0

cat(sprintf("Accuracy:  %.4f\n", accuracy))
cat(sprintf("Precision: %.4f\n", precision))
cat(sprintf("Recall:    %.4f\n", recall))
cat(sprintf("F1 Score:  %.4f\n", f1))

ord      <- order(y_prob, decreasing = TRUE)
y_sorted <- y_test[ord]
n_pos    <- sum(y_test == 1)
n_neg    <- sum(y_test == 0)
tpr      <- cumsum(y_sorted == 1) / n_pos
fpr      <- cumsum(y_sorted == 0) / n_neg
auc      <- sum(abs(diff(fpr)) * (tpr[-1] + tpr[-length(tpr)]) / 2)
cat(sprintf("AUC-ROC:   %.4f\n", auc))

plot(fpr, tpr, type = "l", col = "steelblue", lwd = 2,
     main = "ROC Curve - MLP",
     xlab = "False Positive Rate", ylab = "True Positive Rate")
abline(a = 0, b = 1, lty = 2, col = "gray")
legend("bottomright", legend = sprintf("AUC = %.4f", auc),
       col = "steelblue", lwd = 2)
