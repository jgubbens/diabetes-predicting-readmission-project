set.seed(42)
# set.seed(15)

# Input data (X) and target values (y)
X <- matrix(c(0, 0, 1,
              1, 0, 1,
              1, 1, 1,
              2, 1, 1,
              2, 2, 1), nrow = 5, byrow = TRUE)

# y <- c(0, 1, 2, 5, 6)
y <- c(0, 1, 2, 3, 4)
eta <- 0.1 # step size for gradient descent
q <- 2 # number of hidden nodes

# Initialize weights
# the rows of W1 correspond to the columns of X, the columns to the number of hidden nodes
# the rows of W2 correspond to the number of hidden nodes, the columns to the dimension of the output y
W1 <- matrix(rnorm(3 * q), nrow = 3, ncol = q)
W2 <- matrix(rnorm(q * 1), nrow = q, ncol = 1)

# Define the ReLU activation function
relu <- function(x) {
  matrix(pmax(0, x))
}

# Define the prediction function
f <- function(x) {
  h <- relu(t(W1) %*% x)
  return(t(W2) %*% h)
}

# Gradient descent
errors <- numeric()
epochs <- 400
n <- nrow(X)

for (epoch in 1:epochs) {
  # Update W2
  dW2 <- matrix(0, nrow = 2, ncol = 1)
  for (i in 1:n) {
    x <- matrix(X[i, ], nrow = 3, ncol = 1)
    h <- relu(t(W1) %*% x)
    dW2 <- dW2 + (2 / n) * (f(x) - y[i])[1] * h
  }
  
  # note: it's actually more stable to make this update after calculating dW1
  # but, this asynchronous update is usually fine for simple problems
  W2 <- W2 - eta * dW2
  
  # Update W1
  dW1 <- matrix(0, nrow = 3, ncol = 2)
  for (i in 1:n) {
    x <- matrix(X[i, ], nrow = 3, ncol = 1)
    h <- relu(t(W1) %*% x)
    mat1 <- ifelse(h > 0, 1, 0)  # ReLU derivative
    dW1 <- dW1 + (2 / n) * (f(x) - y[i])[1] * kronecker(t(W2 * mat1), x)
  }
  
  W1 <- W1 - eta * dW1
  
  # Compute error
  e <- (1 / n) * sum((apply(X, MARGIN = 1, FUN = f) - y)^2)
  errors <- c(errors, e)
}

# Print predictions
print(apply(X, MARGIN = 1, FUN = f))

# Plot the errors
plot(1:epochs, errors, type = "l", main = "Error over Epochs", xlab = "Epochs", ylab = "Error")

